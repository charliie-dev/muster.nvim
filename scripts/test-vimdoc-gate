#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

write_canonical_vimdoc() {
  local path="$1"
  cat >"$path" <<'DOC'
INSTALLATION AUTHORITY             *fixture-installation-authority*

  Surface       Probe   Advice      Install
  ------------- ------- ----------- -------
  fixture       Yes     Read-only   No

NEXT SECTION
DOC
}

install_canonical_generator() {
  local fixture="$1"
  cat >"$fixture/scripts/generate-vimdoc" <<'GENERATOR'
#!/usr/bin/env bash
set -euo pipefail
cat >doc/muster.txt <<'DOC'
INSTALLATION AUTHORITY             *fixture-installation-authority*

  Surface       Probe   Advice      Install
  ------------- ------- ----------- -------
  fixture       Yes     Read-only   No

NEXT SECTION
DOC
GENERATOR
}

new_fixture() {
  local name="$1"
  local fixture="$tmp/$name"
  mkdir -p "$fixture/scripts" "$fixture/doc"
  cp "$repo_root/scripts/check-vimdoc" "$fixture/scripts/check-vimdoc"
  write_canonical_vimdoc "$fixture/doc/muster.txt"
  cat >"$fixture/scripts/generate-vimdoc" <<'GENERATOR'
#!/usr/bin/env bash
set -euo pipefail
GENERATOR
  chmod +x "$fixture/scripts/check-vimdoc" "$fixture/scripts/generate-vimdoc"
  git -C "$fixture" init -q
  git -C "$fixture" config user.name fixture
  git -C "$fixture" config user.email fixture@example.invalid
  git -C "$fixture" add scripts doc/muster.txt
  git -C "$fixture" commit -qm initial
  printf '%s\n' "$fixture"
}

expect_failure() {
  local label="$1"
  local fixture="$2"
  local marker="$3"
  if "$fixture/scripts/check-vimdoc" >"$tmp/$label.out" 2>&1; then
    echo "$label unexpectedly passed"
    exit 1
  fi
  if ! grep -F -- "$marker" "$tmp/$label.out" >/dev/null; then
    echo "$label did not report the expected failure"
    exit 1
  fi
}

assert_staged_change() {
  local label="$1"
  local fixture="$2"
  if git -C "$fixture" diff --cached --quiet HEAD -- doc/muster.txt; then
    echo "$label did not create a staged change"
    exit 1
  fi
}

assert_cancellation_state() {
  local label="$1"
  local fixture="$2"
  assert_staged_change "$label" "$fixture"
  if ! git -C "$fixture" diff --quiet HEAD -- doc/muster.txt; then
    echo "$label worktree does not match HEAD"
    exit 1
  fi
}

restore_fixture() {
  local label="$1"
  local fixture="$2"
  git -C "$fixture" reset --hard -q HEAD
  git -C "$fixture" clean -fdq
  if [[ -n "$(git -C "$fixture" status --short)" ]] \
    || ! git -C "$fixture" diff --quiet -- \
    || ! git -C "$fixture" diff --cached --quiet HEAD --; then
    echo "$label cleanup did not restore the index and worktree"
    exit 1
  fi
}

assert_generator_args() {
  local label="$1"
  local actual="$2"
  local scripts_dir="$3"
  cat >"$tmp/$label.expected" <<EOF
--scripts-dir
$scripts_dir
--project-name
muster
--input-file
README.md
--vim-version
NVIM v0.12+
--toc
true
--description
Call the roll on tools your Neovim config declares
--dedup-subheadings
true
--demojify
true
--treesitter
true
--ignore-rawblocks
true
--doc-mapping
false
--doc-mapping-project-name
true
--shift-heading-level-by
0
--increment-heading-level-by
0
EOF
  if ! diff -u "$tmp/$label.expected" "$actual"; then
    echo "$label did not preserve the expected generator arguments"
    exit 1
  fi
}

generator_fixture="$tmp/generator"
panvimdoc_prefix="$generator_fixture/prefix"
panvimdoc_profile="$generator_fixture/profile"
mkdir -p "$generator_fixture/scripts" "$panvimdoc_prefix/bin" \
  "$panvimdoc_prefix/share/scripts" "$panvimdoc_profile/bin"
cp "$repo_root/scripts/generate-vimdoc" "$generator_fixture/scripts/generate-vimdoc"
cat >"$panvimdoc_prefix/bin/panvimdoc" <<'PANVIMDOC'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${GITHUB_ACTIONS:-false}" == true ]]; then
  echo 'mock panvimdoc inherited GITHUB_ACTIONS=true' >&2
  exit 1
fi
printf '%s\n' "$@" >"$PANVIMDOC_ARGS_FILE"
PANVIMDOC
chmod +x "$generator_fixture/scripts/generate-vimdoc" \
  "$panvimdoc_prefix/bin/panvimdoc"
ln -s "$panvimdoc_prefix/bin/panvimdoc" "$panvimdoc_profile/bin/panvimdoc"
non_docker_marker="$generator_fixture/non-docker"
docker_root="$generator_fixture/docker-root"
docker_marker="$docker_root/.dockerenv"
mkdir -p "$docker_root"
: >"$docker_marker"

resolved_args="$tmp/resolved-args"
GITHUB_ACTIONS=true \
  PANVIMDOC_DOCKER_MARKER="$non_docker_marker" \
  PANVIMDOC_SCRIPTS_DIR='' \
  PANVIMDOC_ARGS_FILE="$resolved_args" \
  PATH="$panvimdoc_profile/bin:$PATH" \
  "$generator_fixture/scripts/generate-vimdoc"
resolved_scripts="$(realpath -- "$panvimdoc_prefix/share/scripts")"
assert_generator_args resolved "$resolved_args" "$resolved_scripts"

override_scripts="$generator_fixture/override-scripts"
override_args="$tmp/override-args"
mkdir -p "$override_scripts"
GITHUB_ACTIONS=true \
  PANVIMDOC_DOCKER_MARKER="$non_docker_marker" \
  PANVIMDOC_SCRIPTS_DIR="$override_scripts" \
  PANVIMDOC_ARGS_FILE="$override_args" \
  PATH="$panvimdoc_profile/bin:$PATH" \
  "$generator_fixture/scripts/generate-vimdoc"
assert_generator_args override "$override_args" "$override_scripts"

invalid_output="$tmp/invalid-override.out"
invalid_args="$tmp/invalid-override.args"
if GITHUB_ACTIONS=true \
  PANVIMDOC_DOCKER_MARKER="$non_docker_marker" \
  PANVIMDOC_SCRIPTS_DIR="$generator_fixture/missing-scripts" \
  PANVIMDOC_ARGS_FILE="$invalid_args" \
  PATH="$panvimdoc_profile/bin:$PATH" \
  "$generator_fixture/scripts/generate-vimdoc" >"$invalid_output" 2>&1; then
  echo 'invalid panvimdoc scripts override unexpectedly passed'
  exit 1
fi
if [[ "$(cat "$invalid_output")" != \
  '::error::PANVIMDOC_SCRIPTS_DIR is not a directory' ]]; then
  echo 'invalid panvimdoc scripts override did not report the fixed failure'
  exit 1
fi
if [[ -e "$invalid_args" ]]; then
  echo 'invalid panvimdoc scripts override invoked panvimdoc'
  exit 1
fi

docker_override_output="$tmp/docker-override.out"
docker_override_args="$tmp/docker-override.args"
if GITHUB_ACTIONS=true \
  PANVIMDOC_DOCKER_MARKER="$docker_marker" \
  PANVIMDOC_SCRIPTS_DIR="$override_scripts" \
  PANVIMDOC_ARGS_FILE="$docker_override_args" \
  PATH="$panvimdoc_profile/bin:$PATH" \
  "$generator_fixture/scripts/generate-vimdoc" \
  >"$docker_override_output" 2>&1; then
  echo 'non-action Docker scripts override unexpectedly passed'
  exit 1
fi
if [[ "$(cat "$docker_override_output")" != \
  '::error::PANVIMDOC_SCRIPTS_DIR must be /scripts in Docker' ]]; then
  echo 'non-action Docker scripts override did not report the fixed failure'
  exit 1
fi
if [[ -e "$docker_override_args" ]]; then
  echo 'non-action Docker scripts override invoked panvimdoc'
  exit 1
fi

docker_layout_output="$tmp/docker-layout.out"
docker_layout_args="$tmp/docker-layout.args"
if GITHUB_ACTIONS=true \
  PANVIMDOC_DOCKER_MARKER="$docker_marker" \
  PANVIMDOC_SCRIPTS_DIR='' \
  PANVIMDOC_ARGS_FILE="$docker_layout_args" \
  PATH="$panvimdoc_profile/bin:$PATH" \
  "$generator_fixture/scripts/generate-vimdoc" \
  >"$docker_layout_output" 2>&1; then
  echo 'missing Docker action scripts layout unexpectedly passed'
  exit 1
fi
if [[ "$(cat "$docker_layout_output")" != \
  '::error::panvimdoc Docker action layout requires /scripts' ]]; then
  echo 'missing Docker action scripts layout did not report the fixed failure'
  exit 1
fi
if [[ -e "$docker_layout_args" ]]; then
  echo 'missing Docker action scripts layout invoked panvimdoc'
  exit 1
fi

clean="$(new_fixture clean)"
"$clean/scripts/check-vimdoc"
restore_fixture clean "$clean"

staged_bytes="$(new_fixture staged-bytes)"
printf 'staged-sensitive-bytes\n' >"$staged_bytes/doc/muster.txt"
git -C "$staged_bytes" add doc/muster.txt
install_canonical_generator "$staged_bytes"
assert_staged_change staged-bytes "$staged_bytes"
expect_failure staged-bytes "$staged_bytes" \
  '::error::generated vimdoc index differs from HEAD'
assert_cancellation_state staged-bytes "$staged_bytes"
restore_fixture staged-bytes "$staged_bytes"

staged_symlink="$(new_fixture staged-symlink)"
printf 'do not overwrite\n' >"$staged_symlink/target.txt"
rm "$staged_symlink/doc/muster.txt"
ln -s ../target.txt "$staged_symlink/doc/muster.txt"
git -C "$staged_symlink" add doc/muster.txt
rm "$staged_symlink/doc/muster.txt"
write_canonical_vimdoc "$staged_symlink/doc/muster.txt"
assert_cancellation_state staged-symlink "$staged_symlink"
if [[ "$(git -C "$staged_symlink" ls-files -s doc/muster.txt)" != 120000* ]]; then
  echo 'staged-symlink did not stage a symbolic-link mode'
  exit 1
fi
expect_failure staged-symlink "$staged_symlink" \
  '::error::generated vimdoc index differs from HEAD'
test "$(cat "$staged_symlink/target.txt")" = 'do not overwrite'
restore_fixture staged-symlink "$staged_symlink"

committed_deletion="$(new_fixture committed-deletion)"
git -C "$committed_deletion" rm -q doc/muster.txt
git -C "$committed_deletion" commit -qm deletion
mkdir -p "$committed_deletion/doc"
write_canonical_vimdoc "$committed_deletion/doc/muster.txt"
expect_failure committed-deletion "$committed_deletion" \
  '::error::doc/muster.txt must be a tracked regular file and not a symlink'
restore_fixture committed-deletion "$committed_deletion"

modified="$(new_fixture modified)"
printf '\nmodified\n' >>"$modified/doc/muster.txt"
expect_failure modified "$modified" \
  '::error::generated vimdoc worktree differs from the index'
restore_fixture modified "$modified"

printf 'vimdoc gate fixtures passed\n'
